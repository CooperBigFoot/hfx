{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hfx.dev/schemas/aux/snap.v2.schema.json",
  "title": "HFX Auxiliary Snap v2 Metadata",
  "description": "Metadata block for hfx.aux.snap.v2 auxiliary declarations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "references_levels",
    "weight_semantics"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "references_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "weight_semantics": {
      "type": "string",
      "minLength": 1
    }
  }
}
